# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# production
build

# turbo
.turbo

# misc
.DS_Store
*.pem
.playwright-mcp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (commit only the example)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local state
supabase/.temp/
supabase/.branches/

# stray artifacts (screenshots etc.) — app assets are re-allowed below
*.png
*.jpg
!apps/*/public/*.png
!apps/*/app/icon.png
