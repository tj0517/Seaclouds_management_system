# Copy to apps/timesheet/.env.local (and apps/dcs/.env.local — the two
# NEXT_PUBLIC_* vars suffice there) and fill in. Never commit the filled file.

# Supabase — project URL and keys (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only (storage/admin). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — transactional email API key
RESEND_API_KEY=

# Address that receives admin notifications
ADMIN_NOTIFICATION_EMAIL=

# 1a.13 — absolute URLs of the portal's two separate Next.js deployments
# (module switcher). Both vars are needed in BOTH apps' .env.local: each
# header links to the OTHER app. Local: Timesheet localhost:3000, DCS
# 127.0.0.1:3001.
NEXT_PUBLIC_TES_URL=
NEXT_PUBLIC_DCS_URL=
